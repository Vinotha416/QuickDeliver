# copy to backend/.env
PORT=5000
MONGO_URI=mongodb://localhost:27017/quickdeliver
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
